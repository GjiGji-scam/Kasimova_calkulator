# ui.kv
# Фиолетово-жёлтый калькулятор на чёрном фоне со звёздами
# Кнопки круглые с белой обводкой

#:import settings settings

<RoundButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: settings.YELLOW
    font_size: settings.FONT_SIZE_BUTTON
    bold: True
    canvas.before:
        # Основной фон кнопки (фиолетовый градиент через два круга)
        Color:
            rgba: settings.VIOLET_DARK if self.state == 'down' else settings.VIOLET
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: settings.BUTTON_RADIUS
        # Белая обводка
        Color:
            rgba: settings.WHITE
        Line:
            width: settings.BUTTON_BORDER
            rounded_rectangle: (self.x, self.y, self.width, self.height, settings.BUTTON_RADIUS[0])

<OperatorButton@RoundButton>:
    # Кнопки операторов — жёлтый фон, фиолетовый текст
    color: settings.VIOLET_DARK
    canvas.before:
        Color:
            rgba: settings.YELLOW_DARK if self.state == 'down' else settings.YELLOW
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: settings.BUTTON_RADIUS
        Color:
            rgba: settings.WHITE
        Line:
            width: settings.BUTTON_BORDER
            rounded_rectangle: (self.x, self.y, self.width, self.height, settings.BUTTON_RADIUS[0])

<CalcRoot>:
    canvas.before:
        # Чёрный фон
        Color:
            rgba: settings.BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size
        # Звёзды
        Color:
            rgba: settings.STAR_COLOR
        # Звёзды рисуются через canvas из Python (см. main.py)

    BoxLayout:
        orientation: 'vertical'

        # ===== ДИСПЛЕЙ =====
        BoxLayout:
            size_hint_y: settings.DISPLAY_HEIGHT
            padding: dp(15)
            canvas.before:
                Color:
                    rgba: 0.08, 0.03, 0.15, 0.85
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
                Color:
                    rgba: settings.VIOLET_LIGHT
                Line:
                    width: 2
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 20)

            Label:
                id: display
                text: '0'
                font_size: settings.FONT_SIZE_DISPLAY
                color: settings.YELLOW
                bold: True
                halign: 'right'
                valign: 'middle'
                text_size: self.size
                shorten: True
                shorten_from: 'left'

        # ===== КЛАВИАТУРА =====
        GridLayout:
            cols: 4
            size_hint_y: settings.KEYPAD_HEIGHT
            padding: dp(10)
            spacing: dp(8)

            # Ряд 1
            OperatorButton:
                text: 'C'
                on_press: root.clear()
            OperatorButton:
                text: '⌫'
                on_press: root.backspace()
            OperatorButton:
                text: '%'
                on_press: root.press('%')
            OperatorButton:
                text: '÷'
                on_press: root.press('/')

            # Ряд 2
            RoundButton:
                text: '7'
                on_press: root.press('7')
            RoundButton:
                text: '8'
                on_press: root.press('8')
            RoundButton:
                text: '9'
                on_press: root.press('9')
            OperatorButton:
                text: '×'
                on_press: root.press('*')

            # Ряд 3
            RoundButton:
                text: '4'
                on_press: root.press('4')
            RoundButton:
                text: '5'
                on_press: root.press('5')
            RoundButton:
                text: '6'
                on_press: root.press('6')
            OperatorButton:
                text: '−'
                on_press: root.press('-')

            # Ряд 4
            RoundButton:
                text: '1'
                on_press: root.press('1')
            RoundButton:
                text: '2'
                on_press: root.press('2')
            RoundButton:
                text: '3'
                on_press: root.press('3')
            OperatorButton:
                text: '+'
                on_press: root.press('+')

            # Ряд 5
            RoundButton:
                text: '.'
                on_press: root.press('.')
            RoundButton:
                text: '0'
                on_press: root.press('0')
            RoundButton:
                text: '±'
                on_press: root.negate()
            OperatorButton:
                text: '='
                on_press: root.equals()